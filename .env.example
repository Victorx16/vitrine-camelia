# Contagem de visita (Cloudflare Web Analytics).
#
# Sem esta variável o contador não é escrito no HTML — é assim que
# desenvolvimento e prévia de branch ficam de fora do número.
# O token sai de dash.cloudflare.com > Web Analytics > Add a site.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Conteúdo (Sanity).
#
# Sem estas duas, o build usa o catálogo local em content/pecas.ts e o site
# continua funcionando inteiro. É o que permite trabalhar no layout sem
# depender de rede nem de conta.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
